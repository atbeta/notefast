{
  "name": "notefast",
  "version": "0.93.0",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "bun --filter @notefast/server dev",
    "dev:web": "bun --filter @notefast/web dev",
    "build": "bun --filter @notefast/server build && bun --filter @notefast/web build",
    "build:engine": "bun --filter @notefast/server build:engine",
    "lint": "bun --filter '*' lint",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "check:versions": "bun run scripts/check-versions.ts"
  },
  "devDependencies": {
    "oxlint": "^1.75.0"
  }
}
