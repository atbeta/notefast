<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bun 运行时所需 entitlements（作用于内嵌 notefast-server 可执行）。
         2026-08 实测：allow-unsigned-executable-memory / disable-executable-page-protection
         对 Bun 1.3.14 非必需，且是 notarization「Invalid」的常见元凶，已移除。
         dylib（vec0/libsqlite3）随 app 用同一 Developer ID 重签（同 Team），
         disable-library-validation 作兜底；allow-jit 是 JSC 的必需项。 -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
