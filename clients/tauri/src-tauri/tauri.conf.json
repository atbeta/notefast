{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteFast",
  "version": "0.40.0",
  "identifier": "com.notefast.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NoteFast",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "backgroundColor": "#18181b",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/engine": "engine"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
