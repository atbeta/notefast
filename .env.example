# NoteFast — docker-compose.yml 环境变量参考
# 用法：
#   cp .env.example .env
#   docker compose up -d
#
# 请替换所有密钥；勿提交真实 .env。

NOTEFAST_IMAGE=xbeta/notefast:latest

# 鉴权
# AUTH_PASSWORD=your-web-ui-password
# API_TOKEN=your-api-token

# 跨域
CORS_ORIGINS=http://localhost:3140

# AI Provider（可选）
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-xxx
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_API_KEY=sk-xxx
# LLM_MODEL=openai/gpt-4o

# Markdown 本地归档目录（可选；也可用 Web 设置页配置 Sync）
# AUTO_EXPORT_DIR=/app/export

# 数据库备份（SQLite → S3）在 Web 设置页配置，写入 data/backup.config.json。
# 推荐最小 IAM：s3:HeadBucket, s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket。
# 默认 RPO ≈ 1 小时，保留 30 天。
# 恢复（须先停服务）：
#   bun --filter @notefast/server backup:restore -- \
#     --data-dir ./data \
#     --object-key <snapshots/...db> \
#     --yes
