# NoteFast — docker-compose.yml 环境变量参考
# 用法：
#   cp .env.example .env
#   docker compose up -d
#
# 请替换所有密钥；勿提交真实 .env。

NOTEFAST_IMAGE=xbeta/notefast:latest

# 鉴权
# AUTH_PASSWORD=your-web-ui-password
# API_TOKEN=your-api-token

# 跨域
CORS_ORIGINS=http://localhost:3140

# AI Provider（可选）
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-xxx
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_API_KEY=sk-xxx
# LLM_MODEL=openai/gpt-4o

# Litestream 备份（可选，需启用 backup profile）
# S3_BUCKET=notefast-backup
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=xxx
# S3_SECRET_ACCESS_KEY=xxx
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
