# NoteFast 配置

# 服务端口
PORT=3140

# 数据目录（SQLite 数据库文件存储位置）
DATA_DIR=./data

# ───── 鉴权 ─────
# 两个都留空则自动生成 API Key（打印在控制台日志）
# AUTH_PASSWORD=  # Web UI 密码（不设则免鉴权）
# API_TOKEN=      # MCP/API Bearer Token（不设则自动生成 nf_* key）

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# MCP Server 名称
MCP_SERVER_NAME=notefast

# ───── Markdown 自动导出 ─────
AUTO_EXPORT_DIR=./export

# ───── AI Provider ────
# AI_PROVIDER 命中 presets.ts 中的预设 id（minimax / deepseek / siliconflow / openrouter / cohere / voyage / ollama / …）
#   命中后会自动用对应 baseUrl + 默认模型，用户只需填 API_KEY
# 不命中或留空 → 走 LLM_API_URL / LLM_API_KEY（旧兼容）；EMBEDDING_PROVIDER 同理
#
# 推荐：
#   国内自部署：   AI_PROVIDER=siliconflow    AI_API_KEY=sk-...
#   国内 chat：    AI_PROVIDER=minimax        AI_API_KEY=...
#   国外一站式：   AI_PROVIDER=openrouter     AI_API_KEY=sk-or-v1-...
#   本地：         AI_PROVIDER=ollama         (无需 key)
#
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-v1-...

# 可选：模型覆盖（不设则用预设默认值）
# LLM_MODEL=
# LLM_MODEL=gpt-4o-mini

# ─── Embedding 独立通道（可选，缺省时与 Chat 共享 key）───
# 用于语义搜索；可与 Chat 用同一供应商，也可独立（如 voyage / BGE-m3）
# EMBEDDING_PROVIDER=siliconflow     # 命中预设即用其 baseUrl+默认 embeddingModel
# EMBEDDING_API_URL=                 # 自定义 base（未命中预设时使用）
# EMBEDDING_API_KEY=                 # 独立 key（缺省 = 复用 AI_API_KEY）
# EMBEDDING_MODEL=BAAI/bge-m3

# 旧字段（兜底，等价于 LLM_API_URL / LLM_API_KEY / EMBEDDING_*）
# LLM_API_URL=
# LLM_API_KEY=
# EMBEDDING_API_URL=
# EMBEDDING_MODEL=

# ───── Reranker（可选，hybrid search 精排）─────
# 推荐本地 TEI 服务（Text Embeddings Inference）：
#   https://github.com/huggingface/text-embeddings-inference
# 或 SiliconFlow（云端免费 bge-reranker-v2-m3）
# RERANKER_API_URL=http://127.0.0.1:8080
# RERANKER_API_KEY=
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ───── AutoLink（自动反向链接建议）─────
# AUTO_LINK_ENABLED=true
# AUTO_LINK_AUTO_APPLY=false
# AUTO_LINK_SCOPE=all            # all | same-notebook
# AUTO_LINK_MAX_PER_BLOCK=5

# ───── Sync ─────
# SYNC_LOCAL_DIR=./export
# SYNC_AUTO_INTERVAL_MS=3600000    # 1 小时；0 = 关闭自动同步
#
# S3 兼容目标：
#   AWS S3:        Endpoint 留空
#   Cloudflare R2: https://<account>.r2.cloudflarestorage.com
#   MinIO 自建:    https://minio.example.com  (force_path_style=true)
#   阿里云 OSS:    https://oss-<region>.aliyuncs.com  (兼容 S3)
# SYNC_S3_BUCKET=notefast-backup
# SYNC_S3_REGION=auto
# SYNC_S3_ENDPOINT=
# SYNC_S3_ACCESS_KEY_ID=
# SYNC_S3_SECRET_ACCESS_KEY=
# SYNC_S3_PREFIX=notes/
# SYNC_S3_FORCE_PATH_STYLE=false

# ───── S3 流式备份（Litestream 侧车，docker compose --profile backup up）─────
# S3_BUCKET=my-notefast-backup
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false  # MinIO 自建服务需设为 true
