# NoteFast 配置

# 服务端口
PORT=3140

# 数据目录（SQLite 数据库文件存储位置）
DATA_DIR=./data

# ───── 鉴权 ─────
# 两个都留空则自动生成 API Key（打印在控制台日志）
# AUTH_PASSWORD=  # Web UI 密码（不设则免鉴权）
# API_TOKEN=      # MCP/API Bearer Token（不设则自动生成 nf_* key）

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# MCP Server 名称
MCP_SERVER_NAME=notefast

# ───── Markdown 自动导出 ─────
AUTO_EXPORT_DIR=./export

# ───── Embedding（语义搜索）─────
# 推荐 OpenAI 兼容服务商：
#   OpenAI       baseUrl: https://api.openai.com/v1          model: text-embedding-3-small
#   OpenRouter   baseUrl: https://openrouter.ai/api/v1       model: qwen/qwen3-embedding-8b
#   智谱         baseUrl: https://open.bigmodel.cn/api/paas/v4/
#   阿里云灵积   baseUrl: https://dashscope.aliyuncs.com/compatible-mode/v1
#
EMBEDDING_API_URL=https://openrouter.ai/api/v1/embeddings
# EMBEDDING_API_KEY=sk-or-v1-...
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# ───── LLM（标题/摘要 / Chat / AutoLink 抽取）─────
# 推荐模型（按性价比 / 质量排序）：
#   OpenAI gpt-4o-mini       https://platform.openai.com/api-keys
#   DeepSeek deepseek-chat   https://platform.deepseek.com/api_keys   ￥廉价，纯中文友好
#   Minimax M3                OpenAI 兼容
#   Claude 3.5 Sonnet        https://console.anthropic.com  (需走代理)
#
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ───── Reranker（可选，hybrid search 精排）─────
# 推荐本地 TEI 服务（Text Embeddings Inference）：
#   https://github.com/huggingface/text-embeddings-inference
# RERANKER_API_URL=http://127.0.0.1:8080
# RERANKER_API_KEY=
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ───── AutoLink（自动反向链接建议）─────
# AUTO_LINK_ENABLED=true
# AUTO_LINK_AUTO_APPLY=false
# AUTO_LINK_SCOPE=all            # all | same-notebook
# AUTO_LINK_MAX_PER_BLOCK=5

# ───── Sync ─────
# SYNC_LOCAL_DIR=./export
# SYNC_AUTO_INTERVAL_MS=3600000    # 1 小时；0 = 关闭自动同步
#
# S3 兼容目标：
#   AWS S3:        Endpoint 留空
#   Cloudflare R2: https://<account>.r2.cloudflarestorage.com
#   MinIO 自建:    https://minio.example.com  (force_path_style=true)
#   阿里云 OSS:    https://oss-<region>.aliyuncs.com  (兼容 S3)
# SYNC_S3_BUCKET=notefast-backup
# SYNC_S3_REGION=auto
# SYNC_S3_ENDPOINT=
# SYNC_S3_ACCESS_KEY_ID=
# SYNC_S3_SECRET_ACCESS_KEY=
# SYNC_S3_PREFIX=notes/
# SYNC_S3_FORCE_PATH_STYLE=false

# ───── S3 流式备份（Litestream 侧车，docker compose --profile backup up）─────
# S3_BUCKET=my-notefast-backup
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false  # MinIO 自建服务需设为 true
