# NoteFast — docker-compose.yml 环境变量参考
# 用法：
#   cp .env.example .env
#   docker compose up -d
#
# 请替换所有密钥；勿提交真实 .env。

NOTEFAST_IMAGE=xbeta/notefast:latest

# 鉴权（不设置 = 免鉴权，仅限本地开发/可信内网）
# AUTH_PASSWORD=your-web-ui-password
# API_TOKEN=your-api-token

# 跨域
CORS_ORIGINS=http://localhost:3140

# AI Provider（可选）
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-xxx
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_API_KEY=sk-xxx
# LLM_MODEL=openai/gpt-4o

# Markdown 本地归档目录（可选；未配 sync 时会每小时全量重写，大库会卡）。
# 日常便携副本请用设置页「备份与归档」，不要默认开这个兜底循环。
# AUTO_EXPORT_DIR=/app/export

# vault mode（实验，docs/rfcs/0001-vault-mode.md）：把默认 notebook 绑定到一个 Markdown 文件夹，
# 文件夹是权威、SQLite 只是派生索引。Obsidian 等外部工具的改动自动入库；索引可删可重建。
# 一个 DATA_DIR 只能绑一个 vault；换 vault 请换 DATA_DIR。
# VAULT_PATH=/Users/me/Notes
# VAULT_IGNORE=templates,drafts        # 额外忽略的相对路径前缀（隐藏目录 .obsidian/.trash/.git 默认忽略）
# VAULT_WATCH=true                     # false = 不监听，只能 POST /api/v1/vault/rebuild 手动对账
# VAULT_WRITEBACK=true                 # false = NoteFast/MCP 端编辑只落索引、不写文件（RFC 0003）
# VAULT_USE_POLLING=false              # true = 轮询代替原生文件事件（Docker bind mount / 网络盘必开）
# VAULT_POLL_INTERVAL_MS=1000
# VAULT_STABILITY_MS=300               # 编辑器多次写盘合并窗口

# 数据库备份（SQLite → S3）在 Web 设置页配置，写入 data/backup.config.json。
# 推荐最小 IAM：s3:HeadBucket, s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket。
# 默认 RPO ≈ 1 小时，保留 30 天。
# 恢复（须先停服务）：
#   bun --filter @notefast/server backup:restore -- \
#     --data-dir ./data \
#     --object-key <snapshots/...db> \
#     --yes
