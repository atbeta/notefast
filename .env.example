# NoteFast 配置

# 服务端口
PORT=3140

# 数据目录（SQLite 数据库文件存储位置）
DATA_DIR=./data

# ───── 鉴权（单用户模式） ─────
# 两种方式可单独或同时启用，都不设则不鉴权直接放行。
#
# 方式一：API Token — 用于 MCP / API / AI 工具调用
#   请求需携带 Authorization: Bearer <token> 头
#   API_TOKEN=

# 方式二：Web UI 密码 — 用于浏览器登录
#   请求需携带 Authorization: Basic YWRtaW46PHBhc3N3b3JkPg== 头
#   用户名为 admin，密码为此处设置的值
#   AUTH_PASSWORD=

# ───── MCP ─────
# MCP Server 名称
MCP_SERVER_NAME=notefast

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# Markdown 自动导出目录（设为空则禁用自动导出）
AUTO_EXPORT_DIR=./export

# ───── AI ─────
# 一行启用 AI（语义搜索 + 标题生成）
# AI_PROVIDER=openrouter  # 默认，支持 Minimax / DeepSeek / OpenAI 等所有模型
# AI_PROVIDER=zhipu       # 智谱 GLM（国内直达）
# AI_PROVIDER=qwen        # 阿里通义（国内直达）
# AI_API_KEY=sk-or-v1-... # OpenRouter API Key（或智谱/阿里 Key）
#
# 高级覆盖（预设已包含，通常不需要设）：
# EMBEDDING_MODEL=minimax/minimax-01  # 嵌入模型（默认 text-embedding-3-small）
# LLM_MODEL=deepseek/deepseek-chat   # 聊天模型（默认 minimax/minimax-01）

# ───── S3 流式备份（Litestream 侧车，需 docker compose --profile backup up）─────
# 支持 AWS S3 / Cloudflare R2 / MinIO 等 S3 兼容存储
# S3_BUCKET=my-notefast-backup
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false  # MinIO 等自建服务需设为 true
