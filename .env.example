# NoteFast 配置

# 服务端口
PORT=3140

# 数据目录（SQLite 数据库文件存储位置）
DATA_DIR=./data

# ───── 鉴权 ─────
# 两个都留空则自动生成 API Key（打印在控制台日志）
# AUTH_PASSWORD=  # Web UI 密码（不设则免鉴权）
# API_TOKEN=      # MCP/API Bearer Token（不设则自动生成 nf_* key）

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# MCP Server 名称
MCP_SERVER_NAME=notefast

# ───── Markdown 自动导出 ─────
AUTO_EXPORT_DIR=./export

# ───── Embedding（语义搜索）─────
EMBEDDING_API_URL=https://openrouter.ai/api/v1/embeddings
# EMBEDDING_API_KEY=sk-or-v1-...
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# ───── LLM（标题/摘要生成）─────
# Minimax M3 OpenAI 兼容 API
# LLM_API_URL=https://api.minimax.io/v1/chat/completions
# LLM_API_KEY=...
# LLM_MODEL=MiniMax-M3

# ───── S3 流式备份（Litestream 侧车，docker compose --profile backup up）─────
# S3_BUCKET=my-notefast-backup
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false  # MinIO 自建服务需设为 true
