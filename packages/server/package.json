{
  "name": "@notefast/server",
  "version": "0.81.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun && bun run scripts/copy-sqlite-vec.ts",
    "build:engine": "bun run scripts/build-engine.ts",
    "start": "bun run dist/index.js",
    "backup:restore": "bun run src/cli/restoreBackup.ts",
    "eval": "bun run src/eval/runEval.ts",
    "eval:private": "bun run src/eval/generatePrivateEval.ts",
    "lint": "oxlint src",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@hono/zod-validator": "^0.4.3",
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@notefast/core": "workspace:*",
    "hono": "^4.7.5",
    "mammoth": "^1.12.1",
    "sqlite-vec": "0.1.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "jszip": "^3.10.1",
    "typescript": "^5.7.3"
  }
}
